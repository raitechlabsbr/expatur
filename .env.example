# ── Proxy do backend (dev local) ─────────────────────────────────────────────
# Aponta para o servidor onde o PHP /finance/ está a correr
# Para dev local com PHP:       VITE_API_TARGET=http://localhost:8080
# Para usar produção como proxy: VITE_API_TARGET=https://workspace.expaturtravel.com
VITE_API_TARGET=https://workspace.expaturtravel.com

# ── Supabase ──────────────────────────────────────────────────────────────────
# Encontre em: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Ambiente ──────────────────────────────────────────────────────────────────
VITE_ENV=development
