# ── Proxy do backend PHP ─────────────────────────────────────────────────────
# Opção A — PHP local:         VITE_API_TARGET=http://localhost:8080
# Opção B — Servidor de prod:  VITE_API_TARGET=https://workspace.expaturtravel.com
VITE_API_TARGET=https://workspace.expaturtravel.com

# ── Supabase — preencher quando migrar do localStorage ───────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Ambiente
VITE_ENV=development
